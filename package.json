{
  "name": "@forst/dsh-toolkit-local",
  "version": "0.1.3",
  "description": "网页搜索、OpenCode Go 额度与 Pi 会话费用。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js", "cordis.patch.yml", "plugins", "README.md", "LICENSE", "NOTICE.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": { "node": ">=24.9", "dsh": "^0.2.2-alpha.2" },
  "peerDependencies": { "@deepseek-ai/dsh-web": "^0.2.2-alpha.2" },
  "devDependencies": { "@deepseek-ai/dsh-web": "0.2.2-rc.1" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "repository": { "type": "git", "url": "https://github.com/blueforst/dsh-toolkit-local.git" },
  "homepage": "https://github.com/blueforst/dsh-toolkit-local#readme",
  "bugs": { "url": "https://github.com/blueforst/dsh-toolkit-local/issues" },
  "license": "MIT",
  "sourceBaselines": { "quota": "server-metrics@0.1.6", "session-billing": "0.1.4" }
}
