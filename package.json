{
  "name": "@forst/dsh-toolkit-local",
  "version": "0.1.0",
  "description": "DSH 原生增强插件：OpenCode Go 月额度与 Pi 会话费用；浏览器和 Computer Use 沿用 DSH 原生能力。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js", "client.js", "cordis.patch.yml", "plugins", "scripts/build-client.mjs",
    "README.md", "CHANGELOG.md", "LICENSE", "NOTICE.md", "docs"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "prepack": "npm run build",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": { "node": ">=24.9", "dsh": "^0.2.2-alpha.2" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "repository": { "type": "git", "url": "https://github.com/blueforst/dsh-toolkit-local.git" },
  "homepage": "https://github.com/blueforst/dsh-toolkit-local#readme",
  "bugs": { "url": "https://github.com/blueforst/dsh-toolkit-local/issues" },
  "license": "MIT",
  "sourceBaselines": { "quota": "server-metrics@0.1.6", "session-billing": "0.1.4" }
}
